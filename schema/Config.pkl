module Config

import "@devops-shared/Web.pkl"
import "@devops-shared/Gateway.pkl"
import "@devops-shared/HTTP.pkl"

appName: String = "onlyturbofans"
appNamespace: String = "onlyturbofans"
hidden version: String = "latest"
image: String = "ghcr.io/bmurray/onlyturbofans:\(version)"
replicas: Int = 1
appPort: Int = 80

gatewayName: String = "main-gateway"
gatewayClass: String = "traefik"
clusterIssuer: String = "letsencrypt-prod"

domains: Listing<String>
redirectDomains: Listing<String> = new {}

local appLabels = Web.appLabels(appName)
local allDomains: Listing<String> = new {
  ...domains
  ...redirectDomains
}

local gw = Gateway.gateway(gatewayName, appNamespace, gatewayClass, clusterIssuer, allDomains)

local k8sResources = new Listing {
  Web.namespace(appNamespace)
  gw
  Web.service(appName, appNamespace, appPort, appLabels)
  Web.deployment(appName, appNamespace, image, replicas, appPort, appLabels)
  ...HTTP.routes(appName, gw, domains, redirectDomains)
}

output {
  value = k8sResources
  renderer = new YamlRenderer { isStream = true }
  files {
    ["k8s/manifests.yaml"] {
      value = k8sResources
      renderer = new YamlRenderer { isStream = true }
    }
    // Static site - no configs/ entries needed
    // Apps with config would add: ["configs/appconfig.yaml"] { ... }
  }
}
